# ResolveAI Frontend Environment Configuration Example
# -----------------------------------------------------------------------------
# Local Development:
# Leave VITE_API_BASE_URL empty to use Vite development proxy (configured in vite.config.ts)
# VITE_API_BASE_URL=

# Production Deployment (Render Static Site):
# Set to your deployed FastAPI backend URL on Render (without trailing slash):
# Example: https://resolveai-backend.onrender.com
VITE_API_BASE_URL=https://resolveai-backend.onrender.com
