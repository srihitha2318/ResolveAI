# ResolveAI Backend Environment Configuration Example
# Copy this file to .env for local overrides, or set in Render Dashboard
# -----------------------------------------------------------------------------

# Application Environment ('development' or 'production')
APP_NAME=ResolveAI
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
PORT=8000

# Security & Authentication (MANDATORY IN PRODUCTION)
# In production, replace with a 256-bit secure random secret (e.g., openssl rand -hex 32)
SECRET_KEY=resolveai-super-secret-key-development-2026-secure-random
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_DEV_MODE_FALLBACK=true

# Database Persistence
# Default resolves to ./data/resolveai.db within project root.
# On Render with Persistent Disk mounted at /var/data: sqlite:////var/data/resolveai.db
DATABASE_URL=sqlite:///./data/resolveai.db

# LangGraph SQLite Checkpoint Database Path
# On Render with Persistent Disk mounted at /var/data: /var/data/checkpoints.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# CORS Allowed Origins
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional Production Frontend Origin (automatically added to CORS_ORIGINS)
# FRONTEND_URL=https://resolveai-frontend.onrender.com

# SLA Configuration (Hours)
SLA_STANDARD_HOURS=12
SLA_HIGH_VALUE_HOURS=4

# Optional AI / LLM Provider Configuration ('none', 'gemini', 'groq')
LLM_PROVIDER=none
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=gemini-1.5-flash

# Semantic RAG Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION_NAME=policy_knowledge_base
RAG_MAX_CHUNKS=5
RAG_DISTANCE_THRESHOLD=0.80
